module Games exposing
    ( Games, seed, list, get
    , Game, gameId, title, scenes, activeScene
    , Scene, sceneId, sceneTitle
    , GameId, gameIdToString, gameIdFromString
    , SceneId, sceneIdToString, sceneIdFromString
    )

{-| The collection of Games, each holding its Scenes and at most one Active
Scene. The types are opaque so that the rules from `GLOSSARY.md` can't be
bypassed.


# Collection

@docs Games, seed, list, get


# Game

@docs Game, gameId, title, scenes, activeScene


# Scene

@docs Scene, sceneId, sceneTitle


# Ids

Ids are generated by the collection; their string form is for URLs.

@docs GameId, gameIdToString, gameIdFromString
@docs SceneId, sceneIdToString, sceneIdFromString

-}

import Title exposing (Title)


type Games
    = Games
        { nextId : Int
        , games : List GameData
        }


type alias GameData =
    { id : GameId
    , title : Title
    , scenes : List SceneData
    , activeScene : Maybe SceneId
    }


type alias SceneData =
    { id : SceneId
    , title : Title
    }


type GameId
    = GameId String


type SceneId
    = SceneId String


type Game
    = Game GameData


type Scene
    = Scene SceneData


{-| The example Games the app starts with: one with an Active Scene, one
without.
-}
seed : Games
seed =
    List.foldl seedGame
        (Games { nextId = 0, games = [] })
        [ { title = "The Sunken Crypt"
          , scenes =
                [ { title = "The Drowned Gate", active = False }
                , { title = "Hall of Echoes", active = True }
                , { title = "The Crypt Heart", active = False }
                ]
          }
        , { title = "Market Day in Brindle"
          , scenes =
                [ { title = "The Square", active = False }
                , { title = "The Pickpocket's Alley", active = False }
                ]
          }
        ]


type alias SeedGame =
    { title : String
    , scenes : List { title : String, active : Bool }
    }


seedGame : SeedGame -> Games -> Games
seedGame spec (Games collection) =
    case Title.fromString spec.title of
        Just gameTitle ->
            let
                ( sceneData, nextId ) =
                    List.foldl seedScene ( { id = GameId (String.fromInt collection.nextId), title = gameTitle, scenes = [], activeScene = Nothing }, collection.nextId + 1 ) spec.scenes
            in
            Games
                { nextId = nextId
                , games = collection.games ++ [ sceneData ]
                }

        Nothing ->
            Games collection


seedScene : { title : String, active : Bool } -> ( GameData, Int ) -> ( GameData, Int )
seedScene spec ( game, nextId ) =
    case Title.fromString spec.title of
        Just sceneTitle_ ->
            ( { game
                | scenes = game.scenes ++ [ { id = SceneId (String.fromInt nextId), title = sceneTitle_ } ]
                , activeScene =
                    if spec.active then
                        Just (SceneId (String.fromInt nextId))

                    else
                        game.activeScene
              }
            , nextId + 1
            )

        Nothing ->
            ( game, nextId )


{-| Every Game, in creation order.
-}
list : Games -> List Game
list (Games collection) =
    List.map Game collection.games


get : GameId -> Games -> Maybe Game
get id (Games collection) =
    collection.games
        |> List.filter (\game -> game.id == id)
        |> List.head
        |> Maybe.map Game


gameId : Game -> GameId
gameId (Game game) =
    game.id


title : Game -> Title
title (Game game) =
    game.title


{-| The Game's Scenes, in creation order.
-}
scenes : Game -> List Scene
scenes (Game game) =
    List.map Scene game.scenes


activeScene : Game -> Maybe Scene
activeScene (Game game) =
    game.activeScene
        |> Maybe.andThen (\id -> List.filter (\scene -> scene.id == id) game.scenes |> List.head)
        |> Maybe.map Scene


sceneId : Scene -> SceneId
sceneId (Scene scene) =
    scene.id


sceneTitle : Scene -> Title
sceneTitle (Scene scene) =
    scene.title


gameIdToString : GameId -> String
gameIdToString (GameId id) =
    id


{-| Any string is a Game id; one the collection did not generate names no Game.
-}
gameIdFromString : String -> GameId
gameIdFromString =
    GameId


sceneIdToString : SceneId -> String
sceneIdToString (SceneId id) =
    id


{-| Any string is a Scene id; one the collection did not generate names no Scene.
-}
sceneIdFromString : String -> SceneId
sceneIdFromString =
    SceneId
