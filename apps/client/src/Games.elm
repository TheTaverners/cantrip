module Games exposing
    ( Games, seed, list, get
    , createGame, renameGame, deleteGame
    , Game, gameId, title, scenes, activeScene, isActive
    , Scene, sceneId, sceneTitle
    , GameId, gameIdToString, gameIdFromString
    , SceneId
    , createScene, renameScene, deleteScene
    , makeActive
    )

{-| The collection of Games, each holding its Scenes and at most one Active
Scene. The types are opaque so that the rules from `GLOSSARY.md` can't be
bypassed.


# Collection

@docs Games, seed, list, get


# Managing Games

Titles are valid by construction (see `Title`). An operation naming an
unknown id leaves the collection unchanged.

@docs createGame, renameGame, deleteGame


# Game

@docs Game, gameId, title, scenes, activeScene, isActive


# Scene

@docs Scene, sceneId, sceneTitle


# Ids

Ids are generated by the collection. A Game id's string form is for URLs; no
URL names a Scene, so a Scene id has none.

@docs GameId, gameIdToString, gameIdFromString
@docs SceneId


# Managing Scenes

A Scene belongs to the Game it was created in, for its whole life. An
operation naming an unknown Game, or a Scene that isn't one of the Game's,
leaves the collection unchanged.

@docs createScene, renameScene, deleteScene


# Active Scene

There is deliberately no way to clear a Game's Active Scene.

@docs makeActive

-}

import Title exposing (Title)


type Games
    = Games
        { nextId : Int
        , games : List GameData
        }


type alias GameData =
    { id : GameId
    , title : Title
    , scenes : List SceneData
    , activeScene : Maybe SceneId
    }


type alias SceneData =
    { id : SceneId
    , title : Title
    }


type GameId
    = GameId String


type SceneId
    = SceneId String


type Game
    = Game GameData


type Scene
    = Scene SceneData


{-| The example Games the app starts with: one with an Active Scene, one
without.
-}
seed : Games
seed =
    List.foldl seedGame
        (Games { nextId = 0, games = [] })
        [ { title = "The Sunken Crypt"
          , scenes =
                [ { title = "The Drowned Gate", active = False }
                , { title = "Hall of Echoes", active = True }
                , { title = "The Crypt Heart", active = False }
                ]
          }
        , { title = "Market Day in Brindle"
          , scenes =
                [ { title = "The Square", active = False }
                , { title = "The Pickpocket's Alley", active = False }
                ]
          }
        ]


type alias SeedGame =
    { title : String
    , scenes : List SeedScene
    }


type alias SeedScene =
    { title : String
    , active : Bool
    }


seedGame : SeedGame -> Games -> Games
seedGame spec (Games collection) =
    case Title.fromString spec.title of
        Just gameTitle ->
            let
                ( seededGame, nextId ) =
                    List.foldl seedScene ( newGame collection.nextId gameTitle, collection.nextId + 1 ) spec.scenes
            in
            Games
                { nextId = nextId
                , games = collection.games ++ [ seededGame ]
                }

        Nothing ->
            Games collection


seedScene : SeedScene -> ( GameData, Int ) -> ( GameData, Int )
seedScene spec ( game, nextId ) =
    case Title.fromString spec.title of
        Just sceneTitle_ ->
            let
                scene : SceneData
                scene =
                    newScene nextId sceneTitle_
            in
            ( { game
                | scenes = game.scenes ++ [ scene ]
                , activeScene =
                    if spec.active then
                        Just scene.id

                    else
                        game.activeScene
              }
            , nextId + 1
            )

        Nothing ->
            ( game, nextId )


{-| Every Game, in creation order.
-}
list : Games -> List Game
list (Games collection) =
    List.map Game collection.games


get : GameId -> Games -> Maybe Game
get id (Games collection) =
    collection.games
        |> List.filter (\game -> game.id == id)
        |> List.head
        |> Maybe.map Game


{-| Add a Game, with no Scenes, at the end of the list.
-}
createGame : Title -> Games -> Games
createGame gameTitle (Games collection) =
    Games
        { nextId = collection.nextId + 1
        , games = collection.games ++ [ newGame collection.nextId gameTitle ]
        }


renameGame : GameId -> Title -> Games -> Games
renameGame id newTitle (Games collection) =
    Games { collection | games = updateById id (\game -> { game | title = newTitle }) collection.games }


{-| Remove a Game and its Scenes. Its id is never handed out again, so it keeps
naming no Game.
-}
deleteGame : GameId -> Games -> Games
deleteGame id (Games collection) =
    Games { collection | games = List.filter (\game -> game.id /= id) collection.games }


gameId : Game -> GameId
gameId (Game game) =
    game.id


title : Game -> Title
title (Game game) =
    game.title


{-| The Game's Scenes, in creation order.
-}
scenes : Game -> List Scene
scenes (Game game) =
    List.map Scene game.scenes


activeScene : Game -> Maybe Scene
activeScene (Game game) =
    game.activeScene
        |> Maybe.andThen (\id -> List.filter (\scene -> scene.id == id) game.scenes |> List.head)
        |> Maybe.map Scene


{-| Whether this Scene is the Game's Active Scene. A Scene of another Game
never is.
-}
isActive : Game -> Scene -> Bool
isActive (Game game) (Scene scene) =
    game.activeScene == Just scene.id


sceneId : Scene -> SceneId
sceneId (Scene scene) =
    scene.id


sceneTitle : Scene -> Title
sceneTitle (Scene scene) =
    scene.title


gameIdToString : GameId -> String
gameIdToString (GameId id) =
    id


{-| Any string is a Game id; one the collection did not generate names no Game.
-}
gameIdFromString : String -> GameId
gameIdFromString =
    GameId


{-| Make a Scene the Active Scene of its Game, replacing the previous one.
An unknown Game, or a Scene that isn't one of the Game's, changes nothing.
-}
makeActive : GameId -> SceneId -> Games -> Games
makeActive targetGameId targetSceneId (Games collection) =
    Games
        { collection
            | games =
                updateById targetGameId
                    (\game ->
                        if List.any (\scene -> scene.id == targetSceneId) game.scenes then
                            { game | activeScene = Just targetSceneId }

                        else
                            game
                    )
                    collection.games
        }


{-| Add a Scene at the end of a Game's Scenes. It never becomes the Active
Scene on its own, even when the Game has none.
-}
createScene : GameId -> Title -> Games -> Games
createScene targetGameId sceneTitle_ (Games collection) =
    if List.any (\game -> game.id == targetGameId) collection.games then
        Games
            { nextId = collection.nextId + 1
            , games =
                updateById targetGameId
                    (\game -> { game | scenes = game.scenes ++ [ newScene collection.nextId sceneTitle_ ] })
                    collection.games
            }

    else
        Games collection


renameScene : GameId -> SceneId -> Title -> Games -> Games
renameScene targetGameId targetSceneId newTitle (Games collection) =
    Games
        { collection
            | games =
                updateById targetGameId
                    (\game ->
                        { game
                            | scenes =
                                updateById targetSceneId (\scene -> { scene | title = newTitle }) game.scenes
                        }
                    )
                    collection.games
        }


{-| Remove a Scene from its Game. Deleting the Active Scene leaves the Game
with no Active Scene.
-}
deleteScene : GameId -> SceneId -> Games -> Games
deleteScene targetGameId targetSceneId (Games collection) =
    Games
        { collection
            | games =
                updateById targetGameId
                    (\game ->
                        { game
                            | scenes = List.filter (\scene -> scene.id /= targetSceneId) game.scenes
                            , activeScene =
                                if game.activeScene == Just targetSceneId then
                                    Nothing

                                else
                                    game.activeScene
                        }
                    )
                    collection.games
        }


{-| Change the item with this id, leaving the others alone.
-}
updateById : id -> ({ r | id : id } -> { r | id : id }) -> List { r | id : id } -> List { r | id : id }
updateById id change =
    List.map
        (\item ->
            if item.id == id then
                change item

            else
                item
        )


{-| A Game with no Scenes, its id generated from the collection's counter.
-}
newGame : Int -> Title -> GameData
newGame nextId gameTitle =
    { id = GameId (String.fromInt nextId)
    , title = gameTitle
    , scenes = []
    , activeScene = Nothing
    }


{-| A Scene, its id generated from the collection's counter.
-}
newScene : Int -> Title -> SceneData
newScene nextId sceneTitle_ =
    { id = SceneId (String.fromInt nextId)
    , title = sceneTitle_
    }
